{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskHop",
  "mainBinaryName": "DeskHop",
  "version": "0.1.0",
  "identifier": "com.deskhop.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeskHop",
        "width": 440,
        "height": 600,
        "minWidth": 360,
        "minHeight": 480,
        "center": true,
        "visible": false
      },
      {
        "label": "undo",
        "title": "DeskHop",
        "width": 360,
        "height": 96,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
